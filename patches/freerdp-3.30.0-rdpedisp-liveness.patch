+static BOOL disp_server_initialize(DispServerContext* context, BOOL externalThread)
+{
+	WINPR_ASSERT(context);
+	WINPR_ASSERT(context->priv);
+
+	if (context->priv->disp_channel)
+	{
+		WLog_WARN(TAG, "RDPEDISP channel already opened; thread mode cannot be changed");
+		return FALSE;
