+static UINT disp_server_ensure_channel_ready(DispServerContext* context)
 {
 	DWORD BytesReturned = 0;
 	void* buffer = nullptr;
+
+	WINPR_ASSERT(context);
+	DispServerPrivate* priv = context->priv;
+	WINPR_ASSERT(priv);
+
+	if (priv->isReady)
+		return CHANNEL_RC_OK;
+
+	if (WTSVirtualChannelQuery(priv->disp_channel, WTSVirtualChannelReady, &buffer,
+	                           &BytesReturned) == FALSE)
+	{
+		if (GetLastError() == ERROR_NO_DATA)
+			return ERROR_NO_DATA;
+
+		WLog_ERR(TAG, "WTSVirtualChannelQuery failed");
+		return ERROR_INTERNAL_ERROR;
+	}
+
+	priv->isReady = *((BOOL*)buffer);
+	WTSFreeMemory(buffer);
+	WLog_INFO(TAG, "RDPEDISP dynamic channel ready=%" PRId32, priv->isReady);
+	return priv->isReady ? CHANNEL_RC_OK : ERROR_NO_DATA;
+}
