+BOOL WTSVirtualChannelManagerStartSoftSync(HANDLE hServer, UINT32 tunnelType,
+                                           const UINT32* channelIds, size_t channelCount)
+{
+	WTSVirtualChannelManager* vcm = hServer;
+	if (!vcm || !channelIds || channelCount == 0 || channelCount > UINT16_MAX ||
+	    !vcm->drdynvc_channel || vcm->drdynvc_state != DRDYNVC_STATE_READY ||
+	    !vcm->dvc_tunnel_send || vcm->dvc_soft_sync_pending)
+		return FALSE;
+
+	const size_t listSize = 6u + (channelCount * 4u);
+	const size_t pduSize = 10u + listSize;
+	if (pduSize > UINT32_MAX)
+		return FALSE;
+
+	/* Validate the complete selection before mutating the current routing state. */
+	for (size_t index = 0; index < channelCount; index++)
+	{
+		rdpPeerChannel* dvc = wts_get_dvc_channel_by_id(vcm, channelIds[index]);
+		if (!dvc || dvc->dvc_open_state != DVC_OPEN_STATE_SUCCEEDED)
+			return FALSE;
+	}
+
+	wStream* s = Stream_New(nullptr, pduSize);
+	if (!s)
+		return FALSE;
+
+	wts_clear_dvc_udp_state(vcm);
+	for (size_t index = 0; index < channelCount; index++)
+	{
+		rdpPeerChannel* dvc = wts_get_dvc_channel_by_id(vcm, channelIds[index]);
+		WINPR_ASSERT(dvc);
+		dvc->dvc_udp_selected = TRUE;
+	}
+	Stream_Write_UINT8(s, (SOFT_SYNC_REQUEST_PDU << 4));
+	Stream_Write_UINT8(s, 0); /* Pad */
+	Stream_Write_UINT32(s, WINPR_ASSERTING_INT_CAST(UINT32, 8u + listSize));
+	Stream_Write_UINT16(s, SOFT_SYNC_TCP_FLUSHED | SOFT_SYNC_CHANNEL_LIST_PRESENT);
+	Stream_Write_UINT16(s, 1); /* NumberOfTunnels */
+	Stream_Write_UINT32(s, tunnelType);
+	Stream_Write_UINT16(s, WINPR_ASSERTING_INT_CAST(UINT16, channelCount));
+	for (size_t index = 0; index < channelCount; index++)
+		Stream_Write_UINT32(s, channelIds[index]);
+
+	const UINT32 pduLength = WINPR_ASSERTING_INT_CAST(UINT32, Stream_GetPosition(s));
+	ULONG written = 0;
+	const BOOL rc = WTSVirtualChannelWrite(vcm->drdynvc_channel,
+	                                       Stream_BufferAs(s, char),
+	                                       pduLength,
+	                                       &written);
+	Stream_Free(s, TRUE);
+	if (!rc || written != pduLength)
+	{
+		wts_clear_dvc_udp_state(vcm);
+		return FALSE;
+	}
+
+	vcm->dvc_soft_sync_tunnel_type = tunnelType;
+	vcm->dvc_soft_sync_pending = TRUE;
+	vcm->dvc_soft_sync_active = FALSE;
+	return TRUE;
+}
+
+BOOL WTSVirtualChannelManagerReceiveDVCTunnelData(HANDLE hServer, const BYTE* data,
+                                                  UINT32 length)
+{
+	WTSVirtualChannelManager* vcm = hServer;
+	if (!vcm || !data || length == 0 || !vcm->drdynvc_channel ||
+	    vcm->drdynvc_state != DRDYNVC_STATE_READY || !vcm->dvc_soft_sync_active)
+		return FALSE;
+
+	rdpPeerChannel* channel = vcm->drdynvc_channel;
+	Stream_ResetPosition(channel->receiveData);
+	if (!Stream_EnsureRemainingCapacity(channel->receiveData, length))
+		return FALSE;
+	Stream_Write(channel->receiveData, data, length);
+	const BOOL rc = wts_read_drdynvc_pdu(channel);
+	Stream_ResetPosition(channel->receiveData);
+	return rc;
+}
+
+BOOL WTSVirtualChannelManagerIsSoftSyncActive(HANDLE hServer)
+{
+	const WTSVirtualChannelManager* vcm = hServer;
+	return vcm && vcm->dvc_soft_sync_active;
+}
