+static BOOL wts_send_drdynvc_pdu(rdpPeerChannel* dvc, const BYTE* data, UINT32 length)
+{
+	WINPR_ASSERT(dvc);
+	WINPR_ASSERT(dvc->vcm);
+	WTSVirtualChannelManager* vcm = dvc->vcm;
+	if (dvc->dvc_udp_active)
+	{
+		if (!vcm->dvc_soft_sync_active || !vcm->dvc_tunnel_send)
+			return FALSE;
+		return vcm->dvc_tunnel_send(vcm->dvc_tunnel_send_userdata, data, length);
+	}
+
+	ULONG written = 0;
+	return WTSVirtualChannelWrite(vcm->drdynvc_channel, (PCHAR)data, length, &written) &&
+	       written == length;
