+static void wts_set_selected_dvc_active(WTSVirtualChannelManager* vcm, BOOL active,
+                                        BOOL clearSelection)
+{
+	ULONG_PTR* keys = nullptr;
+	const size_t count = HashTable_GetKeys(vcm->dynamicVirtualChannels, &keys);
+	for (size_t index = 0; index < count; index++)
+	{
+		const UINT32* channelId = (const UINT32*)keys[index];
+		rdpPeerChannel* dvc = channelId ? wts_get_dvc_channel_by_id(vcm, *channelId) : nullptr;
+		if (dvc && dvc->dvc_udp_selected)
+		{
+			dvc->dvc_udp_active = active;
+			if (clearSelection)
+				dvc->dvc_udp_selected = FALSE;
+		}
+	}
+	free(keys);
+}
+
+static void wts_clear_dvc_udp_state(WTSVirtualChannelManager* vcm)
+{
+	ULONG_PTR* keys = nullptr;
+	const size_t count = HashTable_GetKeys(vcm->dynamicVirtualChannels, &keys);
+	for (size_t index = 0; index < count; index++)
+	{
+		const UINT32* channelId = (const UINT32*)keys[index];
+		rdpPeerChannel* dvc = channelId ? wts_get_dvc_channel_by_id(vcm, *channelId) : nullptr;
+		if (dvc)
+		{
+			dvc->dvc_udp_selected = FALSE;
+			dvc->dvc_udp_active = FALSE;
+		}
+	}
+	free(keys);
+}
